# Copy to .env and fill in. .env is gitignored and must never be committed.
# Names and empty values only in this file — no real values, ever.

# --- Target service regression switches (Phase 01) ---
# Deliberate, switchable regressions used as ground truth for the gate. Read
# once at startup: changing one means restarting the service, not reloading it.
# Deliberately unprefixed -- these four names are the documented contract.
SLOW_PRICING_MS=0     # integer ms of injected latency in the pricing path; 0 = off
N_PLUS_ONE=0          # 1 = fan a list query out into one query per row
ERROR_RATE=0.0        # probability [0.0-1.0] a request returns 500
TIMEOUT_RATE=0.0      # probability [0.0-1.0] a request hangs past the client deadline

# --- Target service knobs (not fault switches) ---
TARGET_DB_PATH=./data/target.db
TARGET_DB_POOL_SIZE=5
# Seeds the fault RNG. Reproducible only for serial traffic; see faults.py.
TARGET_FAULT_SEED=
TARGET_TIMEOUT_SLEEP_MS=30000

# --- Capture (Phase 02) ---
PULSEFORGE_CAPTURE_ENABLED=0
PULSEFORGE_DATA_DIR=./data

# --- Logging ---
PULSEFORGE_LOG_LEVEL=INFO

# --- Planner (Phase 07) ---
# OpenRouter. Never commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
