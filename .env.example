# Copy to .env and fill in. .env is gitignored and must never be committed.
# Names and empty values only in this file — no real values, ever.

# --- Target service regression switches (Phase 01) ---
# Deliberate, switchable regressions used as ground truth for the gate.
SLOW_PRICING=0
N_PLUS_ONE=0
ERROR_RATE=0.0

# --- Capture (Phase 02) ---
PULSEFORGE_CAPTURE_ENABLED=0
PULSEFORGE_DATA_DIR=./data

# --- Logging ---
PULSEFORGE_LOG_LEVEL=INFO

# --- Planner (Phase 07) ---
# OpenRouter. Never commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
